{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-pencaker",
  "main": "src/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/public/api/*",
      "/job_portal/api/*",
      "/uploads/*",
      "/admin",
      "/cek-cv"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}

