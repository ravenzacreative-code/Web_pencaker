# Cloudflare Workers / Local .dev.vars & Secrets Reference
# NEVER commit .env or .dev.vars to GitHub!

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-publishable-or-anon-key
# Optional (keep secret in Cloudflare Secrets, NEVER exposed to frontend /api/config):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
ADMIN_PASSWORD=your_secure_admin_password_here
SESSION_SECRET=your_random_32_plus_char_secret_string
